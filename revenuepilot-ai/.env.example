# RevenuePilot AI — Environment Variables
# Copy this to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
PORT=8001

# ── MongoDB (same DB as revenuepilot-store) ────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=revenuepilot_store

# ── OpenAI (required for AI narration; service works without it in data-only mode) ──
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Security ──────────────────────────────────────────────────────────────
# Must match the JWT_SECRET in revenuepilot-store for cross-service auth
JWT_SECRET=supersecretjwtkey_revenuepilot_2026_hackathon
JWT_ALGORITHM=HS256

# Optional API key for X-API-Key header auth (leave empty to disable in dev)
API_SECRET_KEY=

# ── Store Backend URL ──────────────────────────────────────────────────────
STORE_BACKEND_URL=http://localhost:8000

# ── Cache ─────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300
