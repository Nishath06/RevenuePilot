# ==============================================================================
# RevenuePilot AI — Backend Microservice Environment Template (.env.example)
# Copy this file to '.env' and populate with your local/production credentials.
# ==============================================================================

# ── App Environment & Server ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
PORT=8001
STORE_BACKEND_URL=http://localhost:8000

# ── Database (MongoDB Atlas / Local MongoDB) ──────────────────────────────────
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
DATABASE_NAME=revenuepilot_store

# ── AI Provider Configuration (Gemini / Grok / OpenAI) ────────────────────────
LLM_PROVIDER=gemini
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Grok (Groq API) [Optional]
GROK_API_KEY=your_groq_api_key_here
GROK_MODEL=grok-4-fast
GROK_BASE_URL=https://api.groq.com/openai/v1

# OpenAI [Optional]
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Authentication & Security ────────────────────────────────────────────────
# Must match JWT_SECRET in revenuepilot-store for cross-service authentication
JWT_SECRET=supersecretjwtkey_revenuepilot_2026_hackathon
JWT_ALGORITHM=HS256

# Optional API Secret Key for header-based API protection (leave blank to disable in dev)
API_SECRET_KEY=

# ── Cache Settings ────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ── AWS Cloud & Local Fallback Integration ────────────────────────────────────
# Set AWS_MODE to 'Cloud' for AWS SDK / EventBridge / SNS, or 'local' for simulation
AWS_MODE=Cloud
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=

# AWS Resource Identifiers
EVENT_BUS_NAME=revenuepilot-event-bus
AWS_SNS_TOPIC_ARN_PAYMENTS=arn:aws:sns:ap-south-1:123456789012:revenuepilot-payments
AWS_SNS_TOPIC_ARN_INVENTORY=arn:aws:sns:ap-south-1:123456789012:revenuepilot-inventory
AWS_SNS_TOPIC_ARN_INCIDENTS=arn:aws:sns:ap-south-1:123456789012:revenuepilot-incidents
AWS_S3_BUCKET_NAME=revenuepilot-reports
AWS_CLOUDWATCH_LOG_GROUP=/revenuepilot/autoops
AWS_CLOUDWATCH_LOG_STREAM=autoops-stream
AWS_CLOUDWATCH_NAMESPACE=RevenuePilot/AutoOps

# AWS Lambda Function Names
AWS_LAMBDA_RECOVERY_NAME=RecoveryLambda
AWS_LAMBDA_REPORTS_NAME=ReportsLambda
AWS_LAMBDA_INVENTORY_NAME=InventoryLambda
AWS_LAMBDA_INCIDENT_NAME=IncidentLambda
AWS_LAMBDA_CLOUDWATCH_NAME=CloudWatchLambda

# ── Recovery AI Agent Settings ────────────────────────────────────────────────
RECOVERY_AGENT_BATCH_SIZE=25
RECOVERY_AGENT_SCORE_THRESHOLD=60
RECOVERY_CAMPAIGN_HOUR=18
RECOVERY_CAMPAIGN_MINUTE=0
RECOVERY_TIMEZONE=Asia/Kolkata
RECOVERY_AGENT_CACHE_HOURS=6
