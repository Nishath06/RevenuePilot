# RevenuePilot AI — Environment Variables
# Copy this to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
PORT=8001

# ── MongoDB (same DB as revenuepilot-store) ────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=revenuepilot_store

# ── OpenAI (required for AI narration; service works without it in data-only mode) ──
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Security ──────────────────────────────────────────────────────────────
# Must match the JWT_SECRET in revenuepilot-store for cross-service auth
JWT_SECRET=must-match-the-store-jwt-secret-and-be-at-least-32-random-bytes
JWT_ALGORITHM=HS256

# Optional API key for X-API-Key header auth (leave empty to disable in dev)
API_SECRET_KEY=

# ── Store Backend URL ──────────────────────────────────────────────────────
STORE_BACKEND_URL=http://localhost:8000

# ── Cache ─────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ── AWS Integration (Real Cloud & Local Fallback) ──────────────────────────
AWS_MODE=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
EVENT_BUS_NAME=revenuepilot-event-bus
AWS_SNS_TOPIC_ARN_PAYMENTS=
AWS_SNS_TOPIC_ARN_INVENTORY=
AWS_SNS_TOPIC_ARN_INCIDENTS=
AWS_SNS_TOPIC_ARN=
AWS_S3_BUCKET_NAME=revenuepilot-reports
AWS_CLOUDWATCH_LOG_GROUP=/revenuepilot/autoops
AWS_CLOUDWATCH_LOG_STREAM=autoops-stream
AWS_CLOUDWATCH_NAMESPACE=RevenuePilot/AutoOps
AWS_LAMBDA_RECOVERY_NAME=revenuepilot-recovery-lambda
